{
  "name": "jinkra-toolbox",
  "version": "1.9.0",
  "private": true,
  "description": "小金工具箱 · Windows 离线工具",
  "author": "Jinkra",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "vite build",
    "prestart": "node scripts/prepare-ffmpeg.mjs && node scripts/prepare-updater.mjs",
    "start": "electron .",
    "desktop": "npm run build && npm start",
    "predist": "node scripts/prepare-ffmpeg.mjs && node scripts/prepare-updater.mjs",
    "dist": "npm run build && node scripts/build-installer.cjs"
  },
  "build": {
    "appId": "Jinkra.Toolbox.Desktop",
    "productName": "小金工具箱",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "npmRebuild": false,
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "THIRD-PARTY.md"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg.exe",
          "LICENSE",
          "README.txt"
        ]
      },
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      },
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "vendor/updater/jinkra-updater.exe",
        "to": "jinkra-updater.exe"
      },
      {
        "from": "vendor/updater/jinkra-memory.exe",
        "to": "jinkra-memory.exe"
      },
      {
        "from": "vendor/updater/jinkra-uninstall-ui.exe",
        "to": "jinkra-uninstall-ui.exe"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "小金工具箱",
      "include": "scripts/installer-shortcuts.nsh"
    },
    "win": {
      "icon": "assets/icon.ico",
      "signExecutable": false,
      "artifactName": "Jinkra-Toolbox-Payload-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "colorjs.io": "^0.7.1",
    "cron-parser": "^5.10.6",
    "diff": "^9.0.0",
    "dompurify": "^3.4.18",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "jsonc-parser": "^3.3.1",
    "jsqr": "^1.4.0",
    "lucide": "^1.77.0",
    "marked": "^18.2.1",
    "opencc-js": "^1.4.2",
    "papaparse": "^5.7.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "playwright-core": "^1.65.1",
    "qrcode": "^1.5.4",
    "vite": "^8.3.8"
  }
}
